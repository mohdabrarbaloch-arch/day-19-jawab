# ─────────────────────────────────────────────────────────────
# Jawab — environment variables
#
# Copy this file to .env and fill in what you need. Every value
# below has a working default, so a fresh clone runs with no .env
# at all. The ones you MUST change for production are marked.
# ─────────────────────────────────────────────────────────────

# ── identity ─────────────────────────────────────────────────
APP_NAME=Jawab
APP_VERSION=1.0.0

# development | production
ENVIRONMENT=development

# true adds verbose logging and drops the HSTS header (for local http)
DEBUG=false

# ── storage ──────────────────────────────────────────────────
# SQLite by default — no server needed, file created on first boot.
# For Postgres:
#   DATABASE_URL=postgresql+psycopg://jawab:jawab@localhost:5432/jawab
DATABASE_URL=sqlite:///./data/jawab.db

# Where index.html / app.js / styles.css live. Leave as-is unless
# you move the static files.
# STATIC_DIR=./app/static

# ── auth ─────────────────────────────────────────────────────
# MUST CHANGE IN PRODUCTION. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-in-production

JWT_ALGORITHM=HS256

# Token lifetime in minutes. Default is 7 days.
JWT_EXPIRE_MINUTES=10080

# ── retrieval ────────────────────────────────────────────────
# How many results to ask the search provider for.
SEARCH_RESULTS=8

# How many of those to actually download and read. Reading is the
# slow part — raising this makes answers better and requests slower.
FETCH_PAGES=5

# Per-request timeout when downloading a page, in seconds.
FETCH_TIMEOUT_SECONDS=6.0

# Hard cap on how many bytes of a page we read. A 40 MB page is a
# problem, not a source.
MAX_PAGE_BYTES=900000

# Sent with every outbound request. Some sites block unknown agents.
USER_AGENT=Mozilla/5.0 (compatible; JawabBot/1.0; +https://github.com/mohdabrarbaloch-arch)

# ── answer synthesis ─────────────────────────────────────────
# Maximum sentences in an answer.
MAX_ANSWER_SENTENCES=7

# Sentences shorter than this are skipped (nav links, captions).
MIN_SENTENCE_CHARS=45

# Sentences longer than this are skipped (run-on paragraphs).
MAX_SENTENCE_CHARS=320

# How many follow-up questions to suggest.
FOLLOWUP_COUNT=4

# ── rate limiting ────────────────────────────────────────────
# Requests allowed per client IP per window.
RATE_LIMIT_REQUESTS=30

# Window length in seconds.
RATE_LIMIT_WINDOW_SECONDS=60

# ── cors ─────────────────────────────────────────────────────
# "*" allows any origin. In production, list your domains:
#   CORS_ORIGINS=https://jawab.example.com,https://www.jawab.example.com
CORS_ORIGINS=*
